<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="midterm.MainPage"
             BackgroundColor="Black">

    <Grid BackgroundColor="Black" RowSpacing="1" ColumnSpacing="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="3*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label x:Name="DisplayLabel" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
               Text="0" FontSize="80" TextColor="White"
               HorizontalTextAlignment="End" VerticalTextAlignment="End" Margin="20" />

        <!-- Row 1 -->
        <Button Text="/" Grid.Row="1" Grid.Column="0"
                BackgroundColor="#FF9800" TextColor="White" FontSize="28" FontAttributes="Bold"
                Clicked="OnOperatorClicked" />
        <Button Text="C" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnClearClicked" />
        <Button Text="DEL" Grid.Row="1" Grid.Column="3"
                BackgroundColor="#808080" TextColor="White" FontSize="22"
                Clicked="OnDeleteClicked" />

        <!-- Row 2 -->
        <Button Text="x" Grid.Row="2" Grid.Column="0"
                BackgroundColor="#FF9800" TextColor="White" FontSize="28" FontAttributes="Bold"
                Clicked="OnOperatorClicked" />
        <Button Text="7" Grid.Row="2" Grid.Column="1"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnDigitClicked" />
        <Button Text="8" Grid.Row="2" Grid.Column="2"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnDigitClicked" />
        <Button Text="9" Grid.Row="2" Grid.Column="3"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnDigitClicked" />

        <!-- Row 3 -->
        <Button Text="-" Grid.Row="3" Grid.Column="0"
                BackgroundColor="#FF9800" TextColor="White" FontSize="28" FontAttributes="Bold"
                Clicked="OnOperatorClicked" />
        <Button Text="4" Grid.Row="3" Grid.Column="1"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnDigitClicked" />
        <Button Text="5" Grid.Row="3" Grid.Column="2"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnDigitClicked" />
        <Button Text="6" Grid.Row="3" Grid.Column="3"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnDigitClicked" />

        <!-- Row 4 -->
        <Button Text="+" Grid.Row="4" Grid.Column="0"
                BackgroundColor="#FF9800" TextColor="White" FontSize="28" FontAttributes="Bold"
                Clicked="OnOperatorClicked" />
        <Button Text="1" Grid.Row="4" Grid.Column="1"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnDigitClicked" />
        <Button Text="2" Grid.Row="4" Grid.Column="2"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnDigitClicked" />
        <Button Text="3" Grid.Row="4" Grid.Column="3"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnDigitClicked" />

        <!-- Row 5 -->
        <Button Text="=" Grid.Row="5" Grid.Column="0"
                BackgroundColor="#FF9800" TextColor="White" FontSize="28" FontAttributes="Bold"
                Clicked="OnCalculateClicked" />
        <Button Text="0" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnDigitClicked" />
        <Button Text="." Grid.Row="5" Grid.Column="3"
                BackgroundColor="#808080" TextColor="White" FontSize="28"
                Clicked="OnDigitClicked" />
    </Grid>
</ContentPage>
