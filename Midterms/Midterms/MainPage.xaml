<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Midterms.MainPage"
             BackgroundColor="#1E1E1E">

    <ContentPage.Resources>
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="32"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="CornerRadius" Value="40"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="TextColor" Value="White"/>
        </Style>
        <Style x:Key="NumberButton" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="BackgroundColor" Value="#333333"/>
        </Style>
        <Style x:Key="OperatorButton" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="BackgroundColor" Value="#FF9F0A"/>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button" BasedOn="{StaticResource Button}">
            <Setter Property="BackgroundColor" Value="#A5A5A5"/>
            <Setter Property="TextColor" Value="Black"/>
            <Setter Property="FontSize" Value="24"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="1.5*,1*,1*,1*,1*,1*" ColumnDefinitions="1*,1*,1*,1*"
          Padding="20,40,20,40" RowSpacing="10" ColumnSpacing="10">
        
        <!-- Display Screen -->
        <StackLayout Grid.Row="0" Grid.ColumnSpan="4" VerticalOptions="End" Spacing="5" Margin="0,0,0,20">
            <Label x:Name="InputDisplay" 
                   Text="" 
                   TextColor="#AAAAAA" 
                   FontSize="32" 
                   HorizontalTextAlignment="End" 
                   LineBreakMode="HeadTruncation" 
                   MaxLines="1"/>
            <Label x:Name="ResultDisplay" 
                   Text="0" 
                   TextColor="White" 
                   FontSize="65" 
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="End" 
                   LineBreakMode="HeadTruncation" 
                   MaxLines="1"/>
        </StackLayout>

        <!-- Row 1 -->
        <Button Text="C" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource ActionButton}" Clicked="OnClearClicked"/>
        <Button Text="DEL" Grid.Row="1" Grid.Column="2" Style="{StaticResource ActionButton}" Clicked="OnDeleteClicked"/>
        <Button Text="÷" Grid.Row="1" Grid.Column="3" Style="{StaticResource OperatorButton}" Clicked="OnOperatorClicked"/>

        <!-- Row 2 -->
        <Button Text="7" Grid.Row="2" Grid.Column="0" Style="{StaticResource NumberButton}" Clicked="OnNumberClicked"/>
        <Button Text="8" Grid.Row="2" Grid.Column="1" Style="{StaticResource NumberButton}" Clicked="OnNumberClicked"/>
        <Button Text="9" Grid.Row="2" Grid.Column="2" Style="{StaticResource NumberButton}" Clicked="OnNumberClicked"/>
        <Button Text="×" Grid.Row="2" Grid.Column="3" Style="{StaticResource OperatorButton}" Clicked="OnOperatorClicked"/>

        <!-- Row 3 -->
        <Button Text="4" Grid.Row="3" Grid.Column="0" Style="{StaticResource NumberButton}" Clicked="OnNumberClicked"/>
        <Button Text="5" Grid.Row="3" Grid.Column="1" Style="{StaticResource NumberButton}" Clicked="OnNumberClicked"/>
        <Button Text="6" Grid.Row="3" Grid.Column="2" Style="{StaticResource NumberButton}" Clicked="OnNumberClicked"/>
        <Button Text="−" Grid.Row="3" Grid.Column="3" Style="{StaticResource OperatorButton}" Clicked="OnOperatorClicked"/>

        <!-- Row 4 -->
        <Button Text="1" Grid.Row="4" Grid.Column="0" Style="{StaticResource NumberButton}" Clicked="OnNumberClicked"/>
        <Button Text="2" Grid.Row="4" Grid.Column="1" Style="{StaticResource NumberButton}" Clicked="OnNumberClicked"/>
        <Button Text="3" Grid.Row="4" Grid.Column="2" Style="{StaticResource NumberButton}" Clicked="OnNumberClicked"/>
        <Button Text="+" Grid.Row="4" Grid.Column="3" Style="{StaticResource OperatorButton}" Clicked="OnOperatorClicked"/>

        <!-- Row 5 -->
        <Button Text="0" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource NumberButton}" Clicked="OnNumberClicked"/>
        <Button Text="." Grid.Row="5" Grid.Column="2" Style="{StaticResource NumberButton}" Clicked="OnNumberClicked"/>
        <Button Text="=" Grid.Row="5" Grid.Column="3" Style="{StaticResource OperatorButton}" Clicked="OnCalculateClicked"/>

    </Grid>
</ContentPage>
