<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDo.Views.ProfilePage"
             Title="Profile"
             BackgroundColor="#F5F5F5">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Frame BackgroundColor="White" CornerRadius="15" Padding="25" HasShadow="False" BorderColor="#E0E0E0">
            <StackLayout Spacing="15">

                <Label Text="👤"
                       FontSize="60"
                       HorizontalOptions="Center" />

                <Label Text="Profile"
                       FontSize="28"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       TextColor="#333333" />

                <BoxView HeightRequest="1" Color="#E0E0E0" />

                <StackLayout Spacing="5">
                    <Label Text="Name"
                           FontSize="12"
                           TextColor="#888888" />
                    <Label x:Name="NameLabel"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#333333" />
                </StackLayout>

                <StackLayout Spacing="5">
                    <Label Text="Email"
                           FontSize="12"
                           TextColor="#888888" />
                    <Label x:Name="EmailLabel"
                           FontSize="18"
                           FontAttributes="Bold"
                           TextColor="#333333" />
                </StackLayout>

            </StackLayout>
        </Frame>

        <Button Text="Logout"
                FontSize="16"
                FontAttributes="Bold"
                BackgroundColor="#E53935"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Clicked="OnLogoutClicked" />

    </VerticalStackLayout>

</ContentPage>
