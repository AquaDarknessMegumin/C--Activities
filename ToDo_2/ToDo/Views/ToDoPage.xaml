<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDo.Views.ToDoPage"
             Title="My Tasks"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="*, Auto" Padding="15">

        <!-- ListView for active ToDo items -->
        <ListView x:Name="ToDoListView"
                  ItemSelected="OnItemSelected"
                  HasUnevenRows="True"
                  SeparatorVisibility="None"
                  BackgroundColor="Transparent"
                  Grid.Row="0">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame Margin="0,5" Padding="15" BackgroundColor="White"
                               CornerRadius="10" HasShadow="False" BorderColor="#E0E0E0">
                            <StackLayout Spacing="5">
                                <Label Text="{Binding item_name}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#333333" />
                                <Label Text="{Binding item_description}"
                                       FontSize="14"
                                       TextColor="#888888"
                                       LineBreakMode="TailTruncation" />
                            </StackLayout>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Header>
                <StackLayout Padding="0,5,0,10">
                    <Label Text="Active Tasks"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#333333" />
                </StackLayout>
            </ListView.Header>

            <ListView.Footer>
                <StackLayout Padding="0,10">
                    <Label x:Name="EmptyLabel"
                           Text="No tasks yet. Tap + to add one!"
                           FontSize="14"
                           TextColor="#AAAAAA"
                           HorizontalOptions="Center"
                           IsVisible="False" />
                </StackLayout>
            </ListView.Footer>
        </ListView>

        <!-- Add Button -->
        <Button Text="＋ Add Task"
                FontSize="16"
                FontAttributes="Bold"
                BackgroundColor="#512BD4"
                TextColor="White"
                CornerRadius="10"
                HeightRequest="50"
                Margin="0,10,0,5"
                Grid.Row="1"
                Clicked="OnAddClicked" />

    </Grid>

</ContentPage>
