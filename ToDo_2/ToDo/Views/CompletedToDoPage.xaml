<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ToDo.Views.CompletedToDoPage"
             Title="Completed"
             BackgroundColor="#F5F5F5">

    <Grid RowDefinitions="*" Padding="15">

        <ListView x:Name="CompletedListView"
                  ItemSelected="OnItemSelected"
                  HasUnevenRows="True"
                  SeparatorVisibility="None"
                  BackgroundColor="Transparent">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ViewCell>
                        <Frame Margin="0,5" Padding="15" BackgroundColor="White"
                               CornerRadius="10" HasShadow="False" BorderColor="#E0E0E0">
                            <StackLayout Spacing="5">
                                <Label Text="{Binding item_name}"
                                       FontSize="18"
                                       FontAttributes="Bold"
                                       TextColor="#333333"
                                       TextDecorations="Strikethrough" />
                                <Label Text="{Binding item_description}"
                                       FontSize="14"
                                       TextColor="#888888"
                                       LineBreakMode="TailTruncation" />
                                <Label Text="✓ Completed"
                                       FontSize="12"
                                       TextColor="#4CAF50"
                                       FontAttributes="Italic" />
                            </StackLayout>
                        </Frame>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.Header>
                <StackLayout Padding="0,5,0,10">
                    <Label Text="Completed Tasks"
                           FontSize="22"
                           FontAttributes="Bold"
                           TextColor="#333333" />
                </StackLayout>
            </ListView.Header>

            <ListView.Footer>
                <StackLayout Padding="0,10">
                    <Label x:Name="EmptyLabel"
                           Text="No completed tasks yet."
                           FontSize="14"
                           TextColor="#AAAAAA"
                           HorizontalOptions="Center"
                           IsVisible="False" />
                </StackLayout>
            </ListView.Footer>
        </ListView>

    </Grid>

</ContentPage>
